map r reload
map R reload
map i recolor
map b toggle_statusbar

set font "Maple Mono NF 15"
set pages-per-row 1
set zoom-min 10
set window-title-basename true
set window-title-page true
set scroll-page-aware true
set scroll-full-overlap 0.01
set scroll-step 100
set scroll-hstep 100
set selection-clipboard clipboard
set search-hadjust true
set render-loading true
set recolor-keephue true

# All color-bearing settings (chrome, highlights, and recolor on/off + endpoints)
# live in the generated per-mode fragment, which theme-switch rewrites on every
# switch and apply_zathura re-sources over D-Bus into running instances. The
# include path is relative because zathura's include does not expand ~; it
# resolves through stow's symlink from ~/.config/zathura/ to ~/.local/state/theme/.
# It is placed last so it wins over any color default above.
include ../../.local/state/theme/zathura-colors
