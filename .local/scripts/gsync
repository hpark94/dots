#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 1 ]]; then
    echo "gsync: usage: gsync [message]" >&2
    echo "gsync: at most one commit message argument allowed, got $#" >&2
    exit 1
fi

if ! git stash; then
    echo "gsync: failed to stash changes." >&2
    exit 1
fi

if ! git pull; then
    echo "gsync: failed to pull updates." >&2
    exit 1
fi

if ! git stash pop; then
    echo "gsync: conflict during stash pop. Resolve it manually." >&2
    exit 1
fi

message=""

if [[ $# -eq 1 ]]; then
    message="$1"
else
    message="Update $(date +%Y-%m-%d_%H-%M)"
fi

git add --all
git commit -m "${message}"
git push
