#!/usr/bin/env bash
set -euo pipefail

# delta has no "side-by-side only when wide enough" option. As a git pager its
# stdout is the terminal, so `tput cols` reports the real width here.

readonly WIDE_THRESHOLD=100

cols=$(tput cols 2>/dev/null || true)
if [[ ! "${cols}" =~ ^[0-9]+$ ]]; then
    cols=${COLUMNS:-0}
fi
if [[ ! "${cols}" =~ ^[0-9]+$ ]]; then
    cols=0
fi

if ((cols >= WIDE_THRESHOLD)); then
    exec delta --side-by-side "$@"
fi

exec delta "$@"
