#!/usr/bin/env bash
set -euo pipefail

if [[ $# -gt 1 ]]; then
    echo "tmux-sessionizer: usage: tmux-sessionizer [directory]" >&2
    echo "tmux-sessionizer: at most one directory argument allowed, got $#" >&2
    exit 1
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux-sessionizer: tmux not available." >&2
    exit 1
fi

fixed_paths=(
    ~/
    ~/dots
    ~/projects
    ~/bookmarks
    ~/repos
)

search_paths=(
    ~/projects
    ~/bookmarks
    ~/repos
)

if [[ $# -eq 1 ]]; then
    if [[ ! -d "$1" ]]; then
        echo "tmux-sessionizer: not a directory: $1" >&2
        exit 1
    fi
    selected=$1
else
    if ! command -v fzf >/dev/null 2>&1; then
        echo "tmux-sessionizer: fzf not available." >&2
        exit 1
    fi

    options=("${fixed_paths[@]}")

    while IFS= read -r line; do
        options+=("${line}")
    done < <(find "${search_paths[@]}" -mindepth 1 -maxdepth 1 ! -name '.*' \( -type d -o -xtype d \) 2>/dev/null)

    # Launched from a tmux popup, this inherits the tmux server's
    # frozen environment, so the theme vars have to come off disk instead.
    theme_env="${XDG_STATE_HOME:-${HOME}/.local/state}/theme/shell-env.sh"
    # shellcheck disable=SC1090
    [[ -r "${theme_env}" ]] && source "${theme_env}"

    # An fzf abort exits 130, which errexit would turn into a failure; the empty
    # selection below is the intended quiet exit instead.
    selected=$(printf "%s\n" "${options[@]}" | fzf --bind "esc:abort") || true
fi

if [[ -z ${selected} ]]; then
    exit 0
fi

# A colon is tmux's session:window separator, so it can never match a session.
selected_name=$(basename "${selected}" | tr '.:' '__')
tmux_running=$(pgrep tmux) || true

if [[ -z ${TMUX:-} ]] && [[ -z ${tmux_running} ]]; then
    tmux new-session -s "${selected_name}" -c "${selected}"
    exit 0
fi

if ! tmux has-session -t="${selected_name}" 2>/dev/null; then
    tmux new-session -ds "${selected_name}" -c "${selected}"
fi

if [[ -z ${TMUX:-} ]]; then
    tmux attach-session -t "${selected_name}"
else
    tmux switch-client -t "${selected_name}"
fi
