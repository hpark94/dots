#!/usr/bin/env bash
set -euo pipefail

target_dir="${1:-.}"

if [[ ! -d "${target_dir}" ]]; then
    echo "fp: target directory does not exist: ${target_dir}" >&2
    exit 1
fi

mapfile -t available_types < <(wl-paste --list-types 2>/dev/null || true)

if [[ ${#available_types[@]} -eq 0 ]]; then
    echo "fp: clipboard is empty or unavailable." >&2
    exit 1
fi

has_type() {
    local needle="$1" type
    for type in "${available_types[@]}"; do
        [[ "${type}" == "${needle}" ]] && return 0
    done
    return 1
}

print_result() {
    local absolute_path
    absolute_path=$(realpath "$1")
    if [[ "${absolute_path}" == "${HOME}"* ]]; then
        printf '~%s\n' "${absolute_path#"${HOME}"}"
    else
        printf '%s\n' "${absolute_path}"
    fi
}

unique_path() {
    local base="$1" stem ext candidate n=1
    if [[ "${base}" == *.* ]]; then
        stem="${base%.*}"
        ext=".${base##*.}"
    else
        stem="${base}"
        ext=""
    fi
    candidate="${target_dir}/${base}"
    while [[ -e "${candidate}" ]]; do
        candidate="${target_dir}/${stem}_${n}${ext}"
        ((n++))
    done
    printf '%s' "${candidate}"
}

# jpeg is the only subtype that is not already a usable extension.
mime_extension() {
    local subtype="${1##*/}"
    subtype="${subtype%%;*}"
    subtype="${subtype%%+*}"
    if [[ "${subtype}" == "jpeg" ]]; then
        printf 'jpg'
    else
        printf '%s' "${subtype}"
    fi
}

# The first non-text type wins: source apps list their preferred image type
# first, so the order is theirs rather than a richness ranking of ours.
pick_binary_type() {
    local type
    for type in "${available_types[@]}"; do
        case "${type}" in
            text/* | TEXT | STRING | UTF8_STRING) continue ;;
            *)
                printf '%s' "${type}"
                return 0
                ;;
        esac
    done
    return 1
}

# Assumes RFC-compliant URIs (literal % and backslash percent-encoded);
# malformed input fails safely on the existence check. Returns non-zero when no
# usable local file was found, so the caller can fall through.
paste_file_uri() {
    local source_file
    source_file=$(printf '%s' "$1" | tr -d '\r' | grep -m1 '^file://' || true)
    [[ -n "${source_file}" ]] || return 1
    source_file="${source_file#file://}"
    source_file=$(printf '%b' "${source_file//%/\\x}")
    [[ -f "${source_file}" ]] || return 1
    local dest
    dest=$(unique_path "$(basename "${source_file}")")
    cp "${source_file}" "${dest}" || return 1
    print_result "${dest}"
}

# A file manager's Ctrl+C: the payload is `copy\nfile://<uri>`, so the shared
# file:// handler serves it once the leading operation line is ignored.
if has_type "x-special/gnome-copied-files"; then
    if paste_file_uri "$(wl-paste --type x-special/gnome-copied-files 2>/dev/null)"; then
        exit 0
    fi
fi

if has_type "text/uri-list"; then
    if paste_file_uri "$(wl-paste --type text/uri-list 2>/dev/null)"; then
        exit 0
    fi
    # A browser "copy image" offers a text/uri-list (http:// URL) alongside an
    # image/png, so a missing local file:// must fall through to the binary
    # branch and save the bytes rather than error out.
fi

if binary_type=$(pick_binary_type); then
    ext=$(mime_extension "${binary_type}")
    dest=$(unique_path "paste_$(date +%Y%m%d_%H%M%S).${ext}")
    # Remove the partial file if we exit before confirming a good write.
    trap 'rm -f "$dest"' EXIT
    wl-paste --type "${binary_type}" >"${dest}" 2>/dev/null || true
    if [[ ! -s "${dest}" ]]; then
        echo "fp: failed to read clipboard contents for type ${binary_type}." >&2
        exit 1
    fi
    trap - EXIT
    print_result "${dest}"
    exit 0
fi

echo "fp: clipboard holds only text, not a file or asset." >&2
exit 1
