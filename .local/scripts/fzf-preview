#!/usr/bin/env bash
set -euo pipefail

# One renderer behind every fzf preview (ffd, _fzf_comprun, fzf-tab), so a
# directory and a file look the same wherever a preview window is drawn.

main() {
    local cmd
    for cmd in eza bat; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "fzf-preview: ${cmd} not available. Is ${cmd} installed?" >&2
            exit 1
        fi
    done

    if [[ $# -lt 1 || $# -gt 2 ]]; then
        echo "fzf-preview: usage: fzf-preview <path> [line]" >&2
        exit 1
    fi

    local target="$1"

    if [[ ! -e "${target}" ]]; then
        echo "fzf-preview: path does not exist: ${target}" >&2
        exit 1
    fi

    if [[ -d "${target}" ]]; then
        # head closes the pipe once it has its 200 lines; feeding it from a
        # process substitution keeps eza's resulting SIGPIPE away from pipefail.
        head -200 < <(eza --tree --color=always --level=2 "${target}")
        return
    fi

    if [[ $# -eq 2 ]]; then
        bat --style=numbers --color=always --highlight-line "$2" "${target}"
    else
        bat --style=numbers --color=always "${target}"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
