#!/usr/bin/env bash
set -euo pipefail

# One renderer behind every fzf preview (ffd, frg, _fzf_comprun, fzf-tab), so a
# directory, a file and an image look the same wherever a preview window is
# drawn.

require() {
    local cmd="$1"
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        echo "fzf-preview: ${cmd} not available. Is ${cmd} installed?" >&2
        exit 1
    fi
}

is_image() {
    # Without file(1) nothing can classify the target, and previewing it as text
    # is exactly what this script did before there was an image branch.
    command -v file >/dev/null 2>&1 || return 1
    [[ "$(file --mime-type -b -- "$1")" == image/* ]]
}

# The pixels belong to the terminal the tmux client is attached to, not to this
# pane, and what identifies that terminal is what it says about itself, never
# the terminfo name it claims: `.config/foot/foot.ini` sets
# `term=xterm-256color` so SSH to hosts without foot terminfo keeps working,
# which leaves #{client_termname} reading `xterm-256color` for a foot window.
# #{client_termtype} carries the terminal's own XTVERSION reply
# (`foot(1.27.0)`, `ghostty 1.3.1`) and is per client, so it stays true after
# reattaching from a different terminal, which the tmux server environment does
# not. TERM_PROGRAM is the same self-report outside tmux, where no server holds
# a stale copy of it.
# One per attached client, because a pane is drawn on every client at once and
# they need not be the same terminal. `tmux display -p` would answer for
# whichever client tmux last considered current, which is a coin toss the moment
# a second terminal is attached.
client_self_reports() {
    if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
        tmux list-clients ${TMUX_PANE:+-t "${TMUX_PANE}"} -F '#{client_termtype}'
    else
        printf '%s\n' "${TERM_PROGRAM:-${TERM:-}}"
    fi
}

rung_for() {
    case "$1" in
        *ghostty* | *kitty*) printf 'kitty\n' ;;
        *foot*) printf 'sixels\n' ;;
        *) printf 'symbols\n' ;;
    esac
}

render_kitty() {
    local target="$1"
    local geometry="$2"

    command -v kitten >/dev/null 2>&1 || return 1

    # --unicode-placeholder is not optional. It draws the image into the text
    # grid, so the next preview redraw overwrites those cells and the image goes
    # with them, and it makes the @0x0 of --place mean the cursor; without it
    # kitten reads that origin as the top-left of the screen and paints a raw
    # graphics command over fzf's own list, which no redraw erases. Inside tmux
    # --passthrough implies the flag, outside tmux nothing does.
    # --transfer-mode is pinned because detecting it costs a terminal round trip
    # on every keystroke.
    local args=(
        --stdin=no --transfer-mode=memory
        --unicode-placeholder --place "${geometry}@0x0"
    )
    if [[ -n "${TMUX:-}" ]]; then
        args+=(--passthrough tmux)
    fi

    kitten icat "${args[@]}" "${target}"
}

# --probe=off because -f has already decided the format, and chafa otherwise
# questions the terminal anyway and waits its default 5 seconds for an answer.
# That is unnoticeable in front of a terminal that replies and a 5 second stall
# per keystroke in front of one that does not, over ssh or on a tty console.
render_chafa() {
    local target="$1"
    local geometry="$2"
    local format="$3"

    command -v chafa >/dev/null 2>&1 || return 1
    chafa --probe=off -f "${format}" -s "${geometry}" "${target}"
}

# Outside tmux the name is the only thing on offer and it can say nothing at
# all: foot unsets TERM_PROGRAM in the process it starts, and
# `.config/foot/foot.ini` renames $TERM, so a foot window is anonymous. Where
# the name yielded no rung, chafa asks the terminal itself and picks the format
# from the answer; no -f, because choosing is the point. The question goes over
# the controlling terminal, since a preview's stdout is fzf's pipe. The wait is
# capped hard: this runs on every keystroke, and a terminal that never answers
# must cost 0.2s, not chafa's default 5. A timeout is not a failure, it draws
# the symbol art this path would have drawn anyway.
render_probed_chafa() {
    local target="$1"
    local geometry="$2"

    command -v chafa >/dev/null 2>&1 || return 1
    chafa --probe=0.2 --probe-mode=ctty -s "${geometry}" "${target}"
}

# Fedora's tmux 3.7b is built without --enable-sixel, so it cannot re-render the
# image, and handing it the escapes raw draws the picture for an instant before
# tmux erases the cells. #{sixel_support} is the Capability Probe for that: it
# gives the rung back the moment a sixel-enabled tmux is running, where pinning
# a version number here would only guess at when that happens.
sixel_survives_tmux() {
    if [[ -z "${TMUX:-}" ]] || ! command -v tmux >/dev/null 2>&1; then
        return 0
    fi

    [[ "$(tmux display -p '#{sixel_support}')" == 1 ]]
}

# Each rung is guarded by the terminal that can actually display it, and a rung
# whose binary is missing or whose render fails drops to the symbol art every
# terminal understands. Detection reads the terminal's self-report rather than
# probing it for protocol support, because a probe is a round trip per
# keystroke; only where no self-report exists to read, outside tmux, is the
# round trip worth its cost. Clients that disagree settle on symbol art: it is
# the only rung that is plain text, so it is the only one correct on all of
# them at once.
render_image() {
    local target="$1"
    local geometry="${FZF_PREVIEW_COLUMNS:-80}x${FZF_PREVIEW_LINES:-24}"
    local rung="" report client_rung

    while IFS= read -r report; do
        client_rung=$(rung_for "${report}")
        if [[ -z "${rung}" ]]; then
            rung="${client_rung}"
        elif [[ "${rung}" != "${client_rung}" ]]; then
            rung=symbols
        fi
    done < <(client_self_reports)

    case "${rung}" in
        kitty)
            render_kitty "${target}" "${geometry}" && return 0
            ;;
        sixels)
            sixel_survives_tmux \
                && render_chafa "${target}" "${geometry}" sixels && return 0
            ;;
        symbols)
            # Inside tmux the client's self-report already answered for free,
            # so nothing here is worth a round trip.
            if [[ -z "${TMUX:-}" ]]; then
                render_probed_chafa "${target}" "${geometry}" && return 0
            fi
            ;;
    esac

    render_chafa "${target}" "${geometry}" symbols
}

main() {
    if [[ $# -lt 1 || $# -gt 2 ]]; then
        echo "fzf-preview: usage: fzf-preview <path> [line]" >&2
        exit 1
    fi

    local target="$1"

    if [[ ! -e "${target}" ]]; then
        echo "fzf-preview: path does not exist: ${target}" >&2
        exit 1
    fi

    if [[ -d "${target}" ]]; then
        require eza
        # head closes the pipe once it has its 200 lines; feeding it from a
        # process substitution keeps eza's resulting SIGPIPE away from pipefail.
        head -200 < <(eza --tree --color=always --level=2 -- "${target}")
        return
    fi

    # A failed ladder falls through to the text path rather than leaving the
    # preview window blank.
    if is_image "${target}" && render_image "${target}"; then
        return
    fi

    require bat

    if [[ $# -eq 2 ]]; then
        bat --style=numbers --color=always --highlight-line "$2" -- "${target}"
    else
        bat --style=numbers --color=always -- "${target}"
    fi
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
