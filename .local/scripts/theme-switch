#!/usr/bin/env bash
set -euo pipefail

theme_state_dir() {
    echo "${XDG_STATE_HOME:-${HOME}/.local/state}/theme"
}

theme_state_file() {
    echo "$(theme_state_dir)/mode"
}

theme_config_dir() {
    echo "${XDG_CONFIG_HOME:-${HOME}/.config}/theme"
}

theme_palette_file() {
    local mode=$1
    echo "$(theme_config_dir)/hp_${mode}.sh"
}

# Canonical Role Marker reader: path, contract and error wording may not drift
# (.scratch/portable-dotfiles/issues/14 and 13). The read itself is corrected
# per theme-switch-expansion/issues/05; do not restore the pinned 2>/dev/null.
read_role() {
    local marker="${XDG_CONFIG_HOME:-${HOME}/.config}/dotfiles/role" role=""
    if [[ -r "${marker}" ]]; then
        role=$(<"${marker}")
    fi
    role="${role//[[:space:]]/}"
    case "${role}" in
        desktop | headless)
            printf '%s' "${role}"
            ;;
        *)
            echo "Error: ${marker} must contain exactly 'desktop' or 'headless'. Fix: printf '%s' desktop > ${marker} (or headless)." >&2
            return 1
            ;;
    esac
}

resolve_mode() {
    local requested=$1
    case "${requested}" in
        dark | light)
            echo "${requested}"
            ;;
        toggle)
            local state_file
            state_file=$(theme_state_file)
            if [[ -f "${state_file}" ]] && [[ "$(<"${state_file}")" == "dark" ]]; then
                echo "light"
            else
                echo "dark"
            fi
            ;;
        *)
            echo "usage: theme-switch dark|light|toggle" >&2
            return 1
            ;;
    esac
}

write_state() {
    local mode=$1
    local state_dir
    state_dir=$(theme_state_dir)
    mkdir -p "${state_dir}"
    printf '%s' "${mode}" >"${state_dir}/mode"
}

foot_colors_block() {
    local palette_file=$1
    # shellcheck disable=SC1090,SC2154
    (
        source "${palette_file}"
        printf 'background=%s\n' "${bg#\#}"
        printf 'foreground=%s\n\n' "${fg#\#}"
        printf 'regular0=%s\n' "${color0#\#}"
        printf 'regular1=%s\n' "${color1#\#}"
        printf 'regular2=%s\n' "${color2#\#}"
        printf 'regular3=%s\n' "${color3#\#}"
        printf 'regular4=%s\n' "${color4#\#}"
        printf 'regular5=%s\n' "${color5#\#}"
        printf 'regular6=%s\n' "${color6#\#}"
        printf 'regular7=%s\n\n' "${color7#\#}"
        printf 'bright0=%s\n' "${color8#\#}"
        printf 'bright1=%s\n' "${color9#\#}"
        printf 'bright2=%s\n' "${color10#\#}"
        printf 'bright3=%s\n' "${color11#\#}"
        printf 'bright4=%s\n' "${color12#\#}"
        printf 'bright5=%s\n' "${color13#\#}"
        printf 'bright6=%s\n' "${color14#\#}"
        printf 'bright7=%s\n\n' "${color15#\#}"
        printf 'selection-foreground=%s\n' "${selection_fg#\#}"
        printf 'selection-background=%s\n' "${selection_bg#\#}"
    )
}

generate_foot() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    {
        printf 'initial-color-theme=%s\n\n' "${mode}"
        printf '[colors-light]\n'
        foot_colors_block "$(theme_palette_file light)"
        printf '\n[colors-dark]\n'
        foot_colors_block "$(theme_palette_file dark)"
    } >"${out_dir}/foot-colors.ini"
}

sway_client_line() {
    local group=$1 color=$2
    printf 'client.%s %s %s #ffffff %s %s' "${group}" "${color}" "${color}" "${color}" "${color}"
}

generate_sway() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    # shellcheck disable=SC1090,SC2154
    (
        source "$(theme_palette_file "${mode}")"
        {
            printf '%s\n' "$(sway_client_line focused "${color11}")"
            printf '%s\n' "$(sway_client_line focused_inactive "${color8}")"
        } >"${out_dir}/sway-colors.conf"
    )
}

generate_ghostty() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    printf 'theme = "hp_%s"\n' "${mode}" >"${out_dir}/ghostty-theme.conf"
}

# delta reads BAT_THEME but implements neither bat's light/dark aliases nor its
# --theme-light/--theme-dark config, so it needs the resolved theme name in an
# included gitconfig fragment.
generate_delta() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    printf '[delta]\n\tsyntax-theme = hp_%s\n' "${mode}" >"${out_dir}/delta.gitconfig"
}

# lazygit offers a selection background but no foreground; light's selection_bg
# barely stands out from the diff's red and green, so light gets a distinct bar.
# The quoted hex sits in a single-item sequence (a bare #... is a YAML comment).
generate_lazygit() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    # shellcheck disable=SC1090,SC2154
    (
        source "$(theme_palette_file "${mode}")"
        local sel="${selection_bg}"
        [[ "${mode}" == "light" ]] && sel="${color6}"
        printf 'gui:\n  theme:\n    selectedLineBgColor:\n      - "%s"\n' "${sel}" \
            >"${out_dir}/lazygit-theme.yml"
    )
}

# A Headless machine swaps the accent slot so its status bar is unmistakable
# from the Desktop's at a glance (clipboard-rewire spec).
tmux_accent_slot() {
    # Must not hard-fail like every other read_role caller: --render has to
    # produce a fragment on Marker-less machines too, so anything but a headless
    # Marker resolves to the Desktop accent.
    if [[ "$(read_role 2>/dev/null || true)" == "headless" ]]; then
        printf 'color1'
    else
        printf 'color4'
    fi
}

tmux_option_pairs() {
    local mode=$1
    local -n _tmux_option_pairs_out=$2
    local accent_slot
    accent_slot=$(tmux_accent_slot)
    # shellcheck disable=SC1090,SC2154
    mapfile -t _tmux_option_pairs_out < <(
        source "$(theme_palette_file "${mode}")"
        local accent="${!accent_slot}"
        printf '%s\n' \
            "window-status-style" "fg=${accent}" \
            "window-status-current-style" "fg=${bg},bold,bg=${accent}" \
            "display-panes-colour" "${accent}" \
            "display-panes-active-colour" "${color3}" \
            "status-style" "fg=${fg},bg=${bg}" \
            "status-left" "#[fg=${accent},bold] #S #[default] " \
            "status-right" "#[fg=${fg}] %H:%M #[fg=${accent},bold] #H " \
            "message-style" "fg=${color5}" \
            "mode-style" "bg=${color12}"
    )
}

generate_tmux() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    local pairs i
    tmux_option_pairs "${mode}" pairs
    {
        for ((i = 0; i < ${#pairs[@]}; i += 2)); do
            printf 'set -g %s "%s"\n' "${pairs[i]}" "${pairs[i + 1]}"
        done
    } >"${out_dir}/tmux-colors.conf"
}

generate_shell_env() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    # Write atomically: a same-directory temp file plus mv, so a shell sourcing
    # the fragment mid-switch reads either the whole old or the whole new file.
    local tmp="${out_dir}/shell-env.sh.tmp.$$"
    # shellcheck disable=SC1090,SC2154
    (
        source "$(theme_palette_file "${mode}")"
        {
            # args map 1:1 onto: fg,bg,hl / fg+,bg+,hl+ / info,prompt,pointer / marker,spinner,header
            printf "export FZF_DEFAULT_OPTS='--color=fg:%s,bg:%s,hl:%s --color=fg+:%s,bg+:%s,hl+:%s --color=info:%s,prompt:%s,pointer:%s --color=marker:%s,spinner:%s,header:%s'\n" \
                "${fg}" "${bg}" "${fg}" "${fg}" "${selection_bg}" "${fg}" "${color4}" "${color5}" "${color1}" "${color2}" "${color5}" "${color3}"
            printf 'export BAT_THEME=%s\n' "${mode}"
        } >"${tmp}"
    )
    mv -f "${tmp}" "${out_dir}/shell-env.sh"
}

# waybar is a *pull* app (ADR-0001): it picks style-dark.css or style-light.css
# itself, so both per-mode fragments are written on every switch and both stay
# on disk. No apply function, no signal.
waybar_colors_block() {
    local palette_file=$1
    # shellcheck disable=SC1090,SC2154
    (
        source "${palette_file}"
        local i
        for i in $(seq 0 15); do
            local -n slot="color${i}"
            printf '@define-color color%d %s;\n' "${i}" "${slot}"
        done
        printf '@define-color bg %s;\n' "${bg}"
        printf '@define-color fg %s;\n' "${fg}"
        printf '@define-color selection_bg %s;\n' "${selection_bg}"
        printf '@define-color selection_fg %s;\n' "${selection_fg}"
    )
}

generate_waybar() {
    # $1 (mode) is unused: waybar picks the mode itself.
    local out_dir=$2
    mkdir -p "${out_dir}"
    waybar_colors_block "$(theme_palette_file light)" >"${out_dir}/waybar-light.css"
    waybar_colors_block "$(theme_palette_file dark)" >"${out_dir}/waybar-dark.css"
}

# swaync is a *push* app with no portal awareness, so it is told explicitly on
# every switch; the tracked style.css sources this one current-mode fragment.
generate_swaync() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    # shellcheck disable=SC1090,SC2154
    (
        source "$(theme_palette_file "${mode}")"
        {
            printf '@define-color bg %s;\n' "${bg}"
            printf '@define-color surface %s;\n' "${selection_bg}"
            printf '@define-color text %s;\n' "${fg}"
            printf '@define-color critical %s;\n' "${color1}"
            printf '@define-color link %s;\n' "${color4}"
            # color0 is dark in both palettes, so a shadow derived from it reads
            # as a shadow in both modes (unlike @text, which inverts).
            printf '@define-color shadow %s;\n' "${color0}"
        } >"${out_dir}/swaync-colors.css"
    )
}

# zathura's two translucent highlights need an rgba() alpha the palette cannot
# carry, hence the decimal split.
hex_to_rgb() {
    local hex=${1#\#}
    printf '%d, %d, %d' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

# zathura is a *push* app; the tracked zathurarc includes this fragment by
# relative path, because zathura's include does not expand ~. Light leaves
# recolor off so pages keep their true color.
generate_zathura() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    local recolor=false
    [[ "${mode}" == "dark" ]] && recolor=true
    # shellcheck disable=SC1090,SC2154
    (
        source "$(theme_palette_file "${mode}")"
        {
            printf 'set default-bg "%s"\n' "${bg}"
            printf 'set default-fg "%s"\n' "${fg}"
            printf 'set statusbar-bg "%s"\n' "${bg}"
            printf 'set statusbar-fg "%s"\n' "${fg}"
            printf 'set inputbar-bg "%s"\n' "${bg}"
            printf 'set inputbar-fg "%s"\n' "${fg}"
            printf 'set highlight-color "rgba(%s, 0.2)"\n' "$(hex_to_rgb "${color6}")"
            printf 'set highlight-active-color "rgba(%s, 0.2)"\n' "$(hex_to_rgb "${color1}")"
            printf 'set highlight-fg "%s"\n' "${color4}"
            printf 'set notification-bg "%s"\n' "${fg}"
            printf 'set notification-fg "%s"\n' "${bg}"
            printf 'set notification-error-bg "%s"\n' "${color1}"
            printf 'set notification-error-fg "%s"\n' "${bg}"
            printf 'set notification-warning-bg "%s"\n' "${color1}"
            printf 'set notification-warning-fg "%s"\n' "${bg}"
            printf 'set completion-bg "%s"\n' "${bg}"
            printf 'set completion-fg "%s"\n' "${fg}"
            printf 'set completion-highlight-bg "%s"\n' "${bg}"
            printf 'set completion-highlight-fg "%s"\n' "${color2}"
            printf 'set recolor %s\n' "${recolor}"
            printf 'set recolor-lightcolor "%s"\n' "${bg}"
            printf 'set recolor-darkcolor "%s"\n' "${fg}"
        } >"${out_dir}/zathura-colors"
    )
}

# fuzzel is a *next-launch* app: spawned fresh per invocation, so its include is
# always current and no apply step exists. The tracked [colors] block is gone, so
# a missing fragment falls back to fuzzel's defaults instead of stale colors.
generate_fuzzel() {
    local mode=$1 out_dir=$2
    mkdir -p "${out_dir}"
    # shellcheck disable=SC1090,SC2154
    (
        source "$(theme_palette_file "${mode}")"
        {
            printf '[colors]\n'
            printf 'background=%sff\n' "${bg#\#}"
            printf 'text=%sff\n' "${fg#\#}"
            printf 'match=%sff\n' "${color4#\#}"
            printf 'selection=%sff\n' "${selection_bg#\#}"
            printf 'selection-text=%sff\n' "${fg#\#}"
            printf 'selection-match=%sff\n' "${color4#\#}"
            printf 'border=%sff\n' "${color11#\#}"
        } >"${out_dir}/fuzzel-colors.ini"
    )
}

apply_foot() {
    local mode=$1 sig=USR2
    [[ "${mode}" == "dark" ]] && sig=USR1
    pkill -"${sig}" -x foot >/dev/null 2>&1 || true
}

# ghostty re-reads its config on SIGUSR2 and applies it to running surfaces, so
# one mode-independent signal suffices, unlike foot's per-mode USR1/USR2
# (ADR-0004). $1 is unused; it keeps every apply_* call site uniform.
apply_ghostty() {
    pkill -USR2 -x ghostty >/dev/null 2>&1 || true
}

apply_sway() {
    local mode=$1
    if [[ -n "${SWAYSOCK:-}" ]] && command -v swaymsg >/dev/null 2>&1; then
        # shellcheck disable=SC1090,SC2154
        (
            source "$(theme_palette_file "${mode}")"
            swaymsg "$(sway_client_line focused "${color11}")" >/dev/null 2>&1 || true
            swaymsg "$(sway_client_line focused_inactive "${color8}")" >/dev/null 2>&1 || true
        )
    fi
}

# The Headless push renders through a non-interactive shell, which never
# activates mise, so a bare `tmux` resolves to the system client, which may be
# too old to speak to a mise-started server. Resolve the shim explicitly.
tmux_bin() {
    local shim="${XDG_DATA_HOME:-${HOME}/.local/share}/mise/shims/tmux"
    if [[ -x "${shim}" ]]; then
        printf '%s\n' "${shim}"
    else
        printf 'tmux\n'
    fi
}

apply_tmux() {
    local mode=$1 tmux_cmd
    tmux_cmd=$(tmux_bin)
    if command -v "${tmux_cmd}" >/dev/null 2>&1 && "${tmux_cmd}" list-sessions >/dev/null 2>&1; then
        local pairs i
        tmux_option_pairs "${mode}" pairs
        for ((i = 0; i < ${#pairs[@]}; i += 2)); do
            "${tmux_cmd}" set-option -g "${pairs[i]}" "${pairs[i + 1]}" >/dev/null 2>&1 || true
        done
    fi
}

apply_gtk() {
    local mode=$1 gtk_theme=Adwaita-light color_scheme=prefer-light
    if [[ "${mode}" == "dark" ]]; then
        gtk_theme=Adwaita-dark
        color_scheme=prefer-dark
    fi
    if command -v gsettings >/dev/null 2>&1; then
        gsettings set org.gnome.desktop.interface gtk-theme "${gtk_theme}" >/dev/null 2>&1 || true
        gsettings set org.gnome.desktop.interface color-scheme "${color_scheme}" >/dev/null 2>&1 || true
    fi
}

apply_swaync() {
    if command -v swaync-client >/dev/null 2>&1; then
        swaync-client -rs >/dev/null 2>&1 || true
    fi
}

apply_zathura() {
    command -v gdbus >/dev/null 2>&1 || return 0
    local names name
    names=$(gdbus call --session \
        --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.ListNames 2>/dev/null) || return 0
    # ListNames returns one ('a', b, ...') tuple; pull each zathura bus name out.
    while read -r name; do
        gdbus call --session \
            --dest "${name}" \
            --object-path /org/pwmt/zathura \
            --method org.pwmt.zathura.SourceConfig >/dev/null 2>&1 || true
    done < <(grep -oE 'org\.pwmt\.zathura\.PID-[0-9]+' <<<"${names}")
}

# Pattern entries (*, ?, !) are skipped: only concrete hosts are pushable.
ssh_config_hosts() {
    local cfg="${HOME}/.ssh/config"
    [[ -r "${cfg}" ]] || return 0
    awk 'tolower($1) == "host" {
		for (i = 2; i <= NF; i++)
			if ($i !~ /[*?!]/) print $i
	}' "${cfg}"
}

# Toggle-time Headless push, to every host with a live ControlMaster socket.
# Timeout-bounded throughout so a stale host cannot hang the local toggle; only
# the deciding path calls this, never --render, so a push never recurses.
push_headless() {
    local mode=$1 host
    command -v ssh >/dev/null 2>&1 || return 0
    # Without -n the render ssh drains this loop's stdin, which is the host list,
    # and the loop ends at the first live host. -O check carries -n to match.
    while read -r host; do
        [[ -n "${host}" ]] || continue
        if timeout 5 ssh -n -o BatchMode=yes -O check "${host}" >/dev/null 2>&1; then
            # The tilde is expanded by the remote shell, not the local one.
            # shellcheck disable=SC2088
            timeout 10 ssh -n -o BatchMode=yes "${host}" \
                "~/.local/scripts/theme-switch --render ${mode}" >/dev/null 2>&1 || true
        fi
    done < <(ssh_config_hosts)
}

notify_mode() {
    local mode=$1
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Theme" "Switched to ${mode} mode" || true
    fi
}

# The Role-agnostic half (theme-switch-expansion spec), reached both by the
# deciding path and by --render.
render() {
    local mode=$1 out_dir
    out_dir=$(theme_state_dir)
    write_state "${mode}"

    generate_foot "${mode}" "${out_dir}"
    generate_sway "${mode}" "${out_dir}"
    generate_ghostty "${mode}" "${out_dir}"
    generate_delta "${mode}" "${out_dir}"
    generate_lazygit "${mode}" "${out_dir}"
    generate_tmux "${mode}" "${out_dir}"
    generate_shell_env "${mode}" "${out_dir}"
    generate_waybar "${mode}" "${out_dir}"
    generate_swaync "${mode}" "${out_dir}"
    generate_zathura "${mode}" "${out_dir}"
    generate_fuzzel "${mode}" "${out_dir}"

    apply_foot "${mode}"
    apply_ghostty "${mode}"
    apply_sway "${mode}"
    apply_tmux "${mode}"
    apply_gtk "${mode}"
    apply_swaync "${mode}"
    apply_zathura "${mode}"
}

usage() {
    cat >&2 <<-'EOF'
		usage:
		  theme-switch dark|light|toggle    decide and apply the Theme Mode (Desktop only)
		  theme-switch --render dark|light  apply a mode decided elsewhere, skipping the Role gate
	EOF
}

main() {
    local arg=${1:-toggle}
    case "${arg}" in
        -h | --help)
            usage
            return 0
            ;;
        --render)
            local render_mode=${2:-}
            case "${render_mode}" in
                dark | light) ;;
                *)
                    echo "Error: --render requires an explicit mode: dark or light." >&2
                    usage
                    return 1
                    ;;
            esac
            render "${render_mode}"
            return 0
            ;;
    esac

    # Only a Desktop may decide the Theme Mode; refuse before anything is written.
    local role mode
    if ! role=$(read_role); then
        return 1
    fi
    if [[ "${role}" == "headless" ]]; then
        echo "Error: this machine's Role is 'headless'; it has no authority to decide the Theme Mode. To apply a mode decided by the Desktop, run: theme-switch --render <dark|light>." >&2
        return 1
    fi

    if ! mode=$(resolve_mode "${arg}"); then
        return 1
    fi
    render "${mode}"
    notify_mode "${mode}"
    push_headless "${mode}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
