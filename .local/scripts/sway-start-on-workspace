#!/usr/bin/env bash
set -euo pipefail

# Places the first window a launched app maps, once, instead of pinning it with
# `assign`: KeePassXC gives its main window, its unlock dialog and its
# access-request dialog one app_id, and the title is still null at map time, so
# no assign criterion can tell them apart and the password prompt gets dragged
# away from the browser that asked for it.

if [[ $# -lt 3 ]]; then
    echo "sway-start-on-workspace: usage: sway-start-on-workspace <workspace-number> <app_id> <command> [args...]" >&2
    exit 1
fi

workspace="$1"
app_id="$2"

if [[ ! "${workspace}" =~ ^[1-9][0-9]*$ ]]; then
    echo "sway-start-on-workspace: workspace must be a positive integer, got: ${workspace}" >&2
    exit 1
fi

# An empty app_id passes the argument count and matches no window sway will ever
# report, so without this the app is started and then waited for in vain.
if [[ -z "${app_id}" ]]; then
    echo "sway-start-on-workspace: app_id must not be empty" >&2
    exit 1
fi

if ! command -v swaymsg >/dev/null 2>&1; then
    echo "sway-start-on-workspace: swaymsg not available. Is sway running?" >&2
    exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "sway-start-on-workspace: jq not available. Is jq installed?" >&2
    exit 1
fi

if ! command -v "$3" >/dev/null 2>&1; then
    echo "sway-start-on-workspace: command not found: $3" >&2
    exit 1
fi

# Subscribe before launching, so a window that maps fast cannot be missed. The
# subscription never ends on its own, so the timeout is what stops a window that
# never appears from hanging this script forever.
exec 3< <(timeout 60 swaymsg -t subscribe -m '["window","tick"]')
subscriber=$!

# Nothing else reads that pipe, so once this script is done with it swaymsg would
# sit out the rest of its timeout unnoticed.
cleanup_subscriber() {
    exec 3<&-
    # Already gone is the ordinary case: the timeout may have fired, or swaymsg
    # may have ended the subscription itself.
    kill "${subscriber}" 2>/dev/null || :
    wait "${subscriber}" 2>/dev/null || :
}
trap cleanup_subscriber EXIT

# sway acknowledges a `["window"]` subscription with nothing, which is why a
# fixed pause once stood in for a sync point. Subscribing to tick as well buys
# the real barrier: sway answers a new tick subscription with
# {"first":true,"payload":""} immediately and ahead of any further event, so
# reading that line proves the subscription is live before the app is launched.
# A tick can never be taken for a window event afterwards, because the filter
# below demands a `change` field that no tick carries.
subscribed=false
while IFS= read -r event <&3; do
    if [[ "$(printf '%s' "${event}" | jq -r 'has("payload")')" == true ]]; then
        subscribed=true
        break
    fi
done

if [[ "${subscribed}" != true ]]; then
    echo "sway-start-on-workspace: the sway subscription ended before it was acknowledged." >&2
    exit 1
fi

# Without closing fd 3 the app would hold the read end of the subscription open
# for its whole lifetime, and swaymsg would never see the pipe go away.
"${@:3}" 3<&- &

con_id=""
while IFS= read -r event <&3; do
    con_id=$(printf '%s' "${event}" \
        | jq -r --arg app_id "${app_id}" \
            'select(.change == "new" and .container.app_id == $app_id) | .container.id')
    if [[ -n "${con_id}" ]]; then
        break
    fi
done

if [[ -z "${con_id}" ]]; then
    echo "sway-start-on-workspace: no new ${app_id} window appeared before the subscription ended." >&2
    exit 1
fi

if ! swaymsg "[con_id=${con_id}] move container to workspace number ${workspace}" >/dev/null; then
    echo "sway-start-on-workspace: failed to move ${app_id} window ${con_id} to workspace ${workspace}." >&2
    exit 1
fi
