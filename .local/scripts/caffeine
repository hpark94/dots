#!/usr/bin/env bash
set -euo pipefail

if ! command -v systemd-inhibit >/dev/null 2>&1; then
    echo "caffeine: systemd-inhibit not available." >&2
    exit 1
fi

if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    echo "caffeine: XDG_RUNTIME_DIR is not set." >&2
    exit 1
fi

# Toggle only the inhibitor this script started. `killall systemd-inhibit` also
# took down foreign locks, a running package manager's among them.
pid_file="${XDG_RUNTIME_DIR}/caffeine.pid"
pid=$(cat "${pid_file}" 2>/dev/null || true)

# A stale file, from an inhibitor that died with its session, falls through here
# and is overwritten by the fresh one below. The name behind the PID is checked
# too, because the kernel hands a dead PID out again to anyone.
if [[ -n "${pid}" && -r "/proc/${pid}/comm" ]] \
    && [[ "$(cat "/proc/${pid}/comm")" == "systemd-inhibit" ]]; then
    kill "${pid}"
    rm -f "${pid_file}"
    exit 0
fi

systemd-inhibit --what=idle --why="Caffeine mode" --who="User" sleep infinity &
inhibitor=$!
printf '%s\n' "${inhibitor}" >"${pid_file}"

# An unreachable logind lets systemd-inhibit exit at once, and the PID file alone
# would then claim a lock nobody holds.
sleep 0.2
if ! kill -0 "${inhibitor}" 2>/dev/null; then
    rm -f "${pid_file}"
    echo "caffeine: systemd-inhibit exited immediately, no idle inhibitor taken." >&2
    exit 1
fi
