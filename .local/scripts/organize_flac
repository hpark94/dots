#!/usr/bin/env bash
set -euo pipefail

MUSIC_DIR="${HOME}/music"

log() {
    local level="$1"
    shift
    if [[ "${level}" == "ERROR" ]]; then
        printf '[%s] [%s] %s\n' "$(date '+%H:%M:%S')" "${level}" "$*" >&2
    else
        printf '[%s] [%s] %s\n' "$(date '+%H:%M:%S')" "${level}" "$*"
    fi
}

check_installation() {
    if ! command -v "$1" >/dev/null 2>&1; then
        log "ERROR" "$1 not installed. Aborting..."
        exit 1
    fi
}

sanitize() {
    local val="$1"
    val="${val,,}"
    val="${val// /_}"
    val="${val//\//_}"
    val="${val//:/-}"
    val="${val//\'/_}"
    echo "${val}"
}

remove_comment() {
    metaflac --remove-tag=COMMENT "$1" >/dev/null 2>&1 || true
}

check_installation metaflac

if [[ ! -d "${MUSIC_DIR}" ]]; then
    log "ERROR" "${MUSIC_DIR} does not exist. Aborting..."
    exit 1
fi

while IFS= read -r -d '' file; do
    absolute_path=$(realpath "${file}")

    remove_comment "${absolute_path}"

    ext="${absolute_path##*.}"

    # A failing tag lookup must leave the value empty for the check below, not
    # abort the whole run through pipefail.
    artist=$(metaflac --show-tag=ARTIST "${absolute_path}" </dev/null | cut -d= -f2) || true
    artist=$(sanitize "${artist}")
    album=$(metaflac --show-tag=ALBUM "${absolute_path}" </dev/null | cut -d= -f2) || true
    album=$(sanitize "${album}")
    title=$(metaflac --show-tag=TITLE "${absolute_path}" </dev/null | cut -d= -f2) || true
    title=$(sanitize "${title}")
    track=$(metaflac --show-tag=TRACKNUMBER "${absolute_path}" </dev/null | cut -d= -f2 | cut -d/ -f1) || true

    if [[ -z ${artist} || -z ${album} || -z ${title} || -z ${track} ]]; then
        log "ERROR" "${absolute_path}: metadata missing!"
        skip_dir="${MUSIC_DIR}/skipped"
        skip_name=$(basename "${absolute_path}")
        skip_file="${skip_dir}/${skip_name}"
        mkdir -p "${skip_dir}"
        mv "${absolute_path}" "${skip_file}"
        continue
    fi

    # Only now: printf on an empty track fails, and under errexit that would end
    # the run before the skipped/ branch above could catch the file.
    track=$(printf "%02d" "${track}")

    newpath="${MUSIC_DIR}/${ext}/${artist}/${album}"

    mkdir -p "${newpath}"

    newname="${track}_${title}-${artist}.${ext}"
    newname="${newpath}/${newname}"

    if [[ "${file}" == "${newname}" ]]; then
        echo "Not changed: ${file}"
        continue
    fi

    log "INFO" "Rename: ${file} -> ${newname}"
    mv -- "${file}" "${newname}"
done < <(find "${MUSIC_DIR}" -type d -name "skipped" -prune -o -type f -name "*.flac" -print0)
