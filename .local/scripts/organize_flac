#!/usr/bin/env bash
set -euo pipefail

# Bash only treats Hangul as a letter under a UTF-8 locale; without this the
# Slug rule would silently turn a Korean title into a row of separators when the
# script runs from a timer or a bare SSH command.
export LC_ALL=C.UTF-8

# The Slug rule collapses runs of `-` with the `+(-)` pattern.
shopt -s extglob

MUSIC_DIR="${HOME}/Music"

log() {
    local level="$1"
    shift
    if [[ "${level}" == "ERROR" ]]; then
        printf '[%s] [%s] %s\n' "$(date '+%H:%M:%S')" "${level}" "$*" >&2
    else
        printf '[%s] [%s] %s\n' "$(date '+%H:%M:%S')" "${level}" "$*"
    fi
}

check_installation() {
    if ! command -v "$1" >/dev/null 2>&1; then
        log "ERROR" "$1 not installed. Aborting..."
        exit 1
    fi
}

# Parentheses are the one punctuation the Slug keeps: the bracketed qualifier
# carries meaning in this library's titles.
slug() {
    local val="${1,,}"
    val="${val//[^[:alnum:]()]/-}"
    val="${val//+(-)/-}"
    val="${val#-}"
    val="${val%-}"
    printf '%s\n' "${val}"
}

remove_comment() {
    metaflac --remove-tag=COMMENT "$1" >/dev/null 2>&1 || true
}

check_installation metaflac

if [[ ! -d "${MUSIC_DIR}" ]]; then
    log "ERROR" "${MUSIC_DIR} does not exist. Aborting..."
    exit 1
fi

while IFS= read -r -d '' file; do
    absolute_path=$(realpath "${file}")

    remove_comment "${absolute_path}"

    ext="${absolute_path##*.}"

    # `|| true`: a failing tag lookup leaves the value empty for the check below
    # instead of aborting the run through pipefail.
    album_artist=$(metaflac --show-tag=ALBUMARTIST "${absolute_path}" </dev/null | cut -d= -f2-) || true
    artist=$(metaflac --show-tag=ARTIST "${absolute_path}" </dev/null | cut -d= -f2-) || true
    # The Album Artist falls back to the Track Artist, which is what the whole
    # path used to be keyed on, so a tagger that omits ALBUMARTIST loses nothing.
    album_artist=$(slug "${album_artist:-${artist}}")
    artist=$(slug "${artist}")
    album=$(metaflac --show-tag=ALBUM "${absolute_path}" </dev/null | cut -d= -f2-) || true
    album=$(slug "${album}")
    title=$(metaflac --show-tag=TITLE "${absolute_path}" </dev/null | cut -d= -f2-) || true
    title=$(slug "${title}")
    track=$(metaflac --show-tag=TRACKNUMBER "${absolute_path}" </dev/null | cut -d= -f2- | cut -d/ -f1) || true

    # Checked after slugging, so a value of pure punctuation counts as unusable
    # rather than filing the file under an empty name. The track pattern belongs
    # here too: printf rejects non-decimal input, which under errexit would end
    # the run.
    if [[ -z ${album_artist} || -z ${artist} || -z ${album} || -z ${title} || ! ${track} =~ ^[0-9]+$ ]]; then
        log "ERROR" "${absolute_path}: metadata missing or unusable!"
        skip_dir="${MUSIC_DIR}/skipped"
        skip_name=$(basename "${absolute_path}")
        skip_file="${skip_dir}/${skip_name}"
        mkdir -p "${skip_dir}"
        if [[ -e "${skip_file}" ]]; then
            log "ERROR" "${skip_file} already taken, leaving ${absolute_path} where it is"
            continue
        fi
        mv -- "${absolute_path}" "${skip_file}"
        continue
    fi

    # Base 10 forced: bash reads a leading zero as octal, so the common 08 and 09
    # would be errors and 010 would silently become 8.
    track=$(printf "%02d" "$((10#${track}))")

    newpath="${MUSIC_DIR}/${ext}/${album_artist}/${album}"

    mkdir -p "${newpath}"

    newname="${track}-${title}-${artist}.${ext}"
    newname="${newpath}/${newname}"

    if [[ "${file}" == "${newname}" ]]; then
        log "INFO" "Not changed: ${file}"
        continue
    fi

    if [[ -e "${newname}" ]]; then
        log "ERROR" "${newname} already taken, leaving ${file} where it is"
        continue
    fi

    log "INFO" "Rename: ${file} -> ${newname}"
    mv -- "${file}" "${newname}"
done < <(find "${MUSIC_DIR}" -type d -name "skipped" -prune -o -type f -name "*.flac" -print0)

# Confined to the flac tree, so Skipped and the mp3 tree are out of reach.
# `-delete` implies depth-first, so a directory left empty only because its
# children went away is removed in the same pass.
if [[ -d "${MUSIC_DIR}/flac" ]]; then
    find "${MUSIC_DIR}/flac" -mindepth 1 -type d -empty -delete
fi
