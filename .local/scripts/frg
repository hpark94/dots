#!/usr/bin/env bash
set -euo pipefail

# Live ripgrep through fzf: fzf owns the query and re-runs rg on every
# keystroke, so `--disabled` is what stops fzf from also filtering the results.
# The opener and preview strings below are fzf's to expand, never this shell's.

main() {
    local cmd
    for cmd in rg fzf; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "frg: ${cmd} not available. Is ${cmd} installed?" >&2
            exit 1
        fi
    done

    local query="$*"

    local reload='reload:rg --column --hidden --color=always --smart-case --glob "!.git/**" {q} || :'

    # shellcheck disable=SC2016
    local opener='
if [[ $FZF_SELECT_COUNT -eq 0 ]]; then
    nvim {1} +{2}
else
    nvim +cw -q {+f}
fi'

    local keybinds=(
        --bind "esc:abort"
        --bind "start:${reload}"
        --bind "change:${reload}"
        --bind "enter:become:${opener}"
        --bind "ctrl-o:execute:${opener}"
        --bind "alt-a:select-all"
        --bind "alt-d:deselect-all"
        --bind "ctrl-/:toggle-preview"
    )

    # +{2} scrolls the preview to the matched line and -/2 backs it off by half
    # the window, which is what puts the match in the middle. fzf measures the
    # size threshold against the preview window, not the terminal, so 50 at the
    # default half split means "above whenever the terminal is under 100 columns".
    local fzf_opts=(
        --disabled
        --ansi
        --multi
        --delimiter ":"
        --preview "fzf-preview {1} {2}"
        --preview-window "+{2}-/2,<50(up)"
        --query "${query}"
    )

    local status=0
    fzf "${fzf_opts[@]}" "${keybinds[@]}" || status=$?

    # fzf exits 1 on no match and 130 when the user aborts; neither is a failure
    # of this script, while anything else is a real fzf error.
    if [[ "${status}" -eq 1 || "${status}" -eq 130 ]]; then
        return 0
    fi
    return "${status}"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
