#!/usr/bin/env bash
set -euo pipefail

# Live ripgrep through fzf: fzf owns the query and re-runs rg on every
# keystroke, so `--disabled` is what stops fzf from also filtering the results.
# The opener and preview strings below are fzf's to expand, never this shell's.

main() {
    local cmd
    for cmd in rg fzf nvim fzf-preview; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "frg: ${cmd} not available. Is ${cmd} installed?" >&2
            exit 1
        fi
    done

    local query="$*"

    local reload='reload:rg --column --hidden --color=always --smart-case --glob "!.git/**" {q} || :'

    # shellcheck disable=SC2016
    local opener='
if [[ $FZF_SELECT_COUNT -eq 0 ]]; then
    nvim {1} +{2}
else
    nvim +cw -q {+f}
fi'

    # `become` replaces fzf with the opener through execve, so on the enter path
    # the status this script sees is nvim's own and not fzf's. An nvim exiting 1
    # or 130 would then be indistinguishable from fzf's "no match" and "abort",
    # which are not failures, and a failed open would be reported as an empty
    # pick. The opener moves just those two collisions onto 121 and 122 and the
    # case below puts them back, so an open that really failed stays a failure
    # with its own status. The price is that 121 and 122 are spent: an nvim that
    # exits with one of them of its own accord is reported as 1 or 130, because
    # execve leaves one status and nothing beside it to tell the two apart.
    # ctrl-o needs none of this: `execute` returns to the picker, and what it ran
    # never reaches this script's status.
    # The variable is not named `s` because fzf would expand `${s}` in a
    # `become` string as its own {s} placeholder and substitute the current line
    # into the test.
    # shellcheck disable=SC2016
    local remap='; rc=$?; [ "${rc}" -eq 1 ] && exit 121; [ "${rc}" -eq 130 ] && exit 122; exit "${rc}"'

    local keybinds=(
        --bind "esc:abort"
        --bind "start:${reload}"
        --bind "change:${reload}"
        --bind "enter:become:${opener}${remap}"
        --bind "ctrl-o:execute:${opener}"
        --bind "alt-a:select-all"
        --bind "alt-d:deselect-all"
        --bind "ctrl-/:toggle-preview"
    )

    # +{2} scrolls the preview to the matched line and -/2 backs it off by half
    # the window, which is what puts the match in the middle. fzf measures the
    # size threshold against the preview window, not the terminal, so 50 at the
    # default half split means "above whenever the terminal is under 100 columns".
    local fzf_opts=(
        --disabled
        --ansi
        --multi
        --delimiter ":"
        --preview "fzf-preview {1} {2}"
        --preview-window "+{2}-/2,<50(up)"
        --query "${query}"
    )

    local status=0
    fzf "${fzf_opts[@]}" "${keybinds[@]}" || status=$?

    case "${status}" in
        # fzf's own: 1 on no match, 130 when the user aborts. On both the opener
        # never ran, so neither is a failure of this script.
        1 | 130) return 0 ;;
        # The two statuses the opener remapped, put back as nvim's own.
        121) return 1 ;;
        122) return 130 ;;
        *) return "${status}" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
