#!/usr/bin/env bash
set -euo pipefail

# Pick files with fzf and hand every selection to one invocation of <tool>.
# Usage: ffd [-b] [tool] [flags...]
# A flag cannot carry a space or a quote: the flags become part of a string fzf
# hands to a shell, which splits them again on whitespace.
# Whether a tool wants the terminal or a window of its own is not knowable
# before it runs, so the foreground is the default and -b is the explicit ask
# for a detached launch.

main() {
    local cmd
    for cmd in fd fzf fzf-preview; do
        if ! command -v "${cmd}" >/dev/null 2>&1; then
            echo "ffd: ${cmd} not available. Is ${cmd} installed?" >&2
            exit 1
        fi
    done

    local background=false
    if [[ "${1:-}" == "-b" ]]; then
        background=true
        shift
    fi

    local tool="${1:-nvim}"
    local flags=("${@:2}")

    # Without --, command -v reads a leading-dash tool name as its own option and
    # reports success for it, so the failure would only surface after the pick.
    if ! command -v -- "${tool}" >/dev/null 2>&1; then
        echo "ffd: '${tool}' is not installed or not in PATH" >&2
        exit 1
    fi

    # fzf shell-quotes {+} itself, so every selection reaches one invocation of
    # the tool under its real name, quotes and spaces included.
    local opener=("${tool}" "${flags[@]}" "{+}")

    if [[ "${background}" == true ]]; then
        if ! command -v setsid >/dev/null 2>&1; then
            echo "ffd: setsid not available, cannot run '${tool}' in the background" >&2
            exit 1
        fi
        # setsid only forks when it already leads a process group, which it does
        # not here; without --fork it would exec the tool in place and hold the
        # terminal, which is the opposite of what -b asks for.
        opener=(setsid --fork "${opener[@]}")
    fi

    local options=(
        --hidden
        --exclude ".git/"
    )

    # `become` replaces fzf with the opener through execve, so on the enter path
    # the status this script sees is the tool's own and not fzf's. A tool exiting
    # 1 or 130 would then be indistinguishable from fzf's "no match" and
    # "abort", which are not failures, and a failed tool would be reported as an
    # empty pick. The opener moves just those two collisions onto 121 and 122
    # and the case below puts them back, so a tool that really failed stays a
    # failure with its own status. The price is that 121 and 122 are spent: a
    # tool that exits with one of them of its own accord is reported as 1 or
    # 130, because execve leaves one status and nothing beside it to tell the
    # two apart. ctrl-o needs none of this: `execute` returns to the picker, and
    # what it ran never reaches this script's status.
    # The variable is not named `s` because fzf would expand `${s}` in a
    # `become` string as its own {s} placeholder and substitute the current line
    # into the test.
    # shellcheck disable=SC2016
    local remap='; rc=$?; [ "${rc}" -eq 1 ] && exit 121; [ "${rc}" -eq 130 ] && exit 122; exit "${rc}"'

    local keybinds=(
        --bind "enter:become:${opener[*]}${remap}"
        --bind "ctrl-o:execute:${opener[*]}"
        --bind "alt-a:select-all"
        --bind "alt-d:deselect-all"
        --bind "ctrl-/:toggle-preview"
    )

    # fzf measures the threshold against the preview window, not the terminal,
    # so 50 at the default half split means "put the preview above whenever the
    # terminal is narrower than 100 columns".
    local preview_opts=(
        --preview "fzf-preview {}"
        --preview-window "<50(up)"
    )

    # fzf stops reading as soon as it has a selection, so a pipeline would hand
    # pipefail fd's SIGPIPE status (141); a descriptor of our own keeps the
    # status fzf's own, keeps fd's stderr on the terminal, and leaves fd's pid
    # to ask about once the picker is done.
    exec 4< <(fd -t f "." "${options[@]}")
    local finder=$!

    local status=0
    fzf --ansi --multi \
        "${keybinds[@]}" \
        "${preview_opts[@]}" <&4 4<&- || status=$?

    # Closing the last read end is what turns fd's next write into the SIGPIPE
    # that ends it, so it has to happen before waiting on it.
    exec 4<&-
    local finder_status=0
    wait "${finder}" || finder_status=$?

    # 141 is that SIGPIPE, and means only that fzf already had what it needed.
    # Anything else is fd failing for real, on a list the pick was made from.
    if [[ "${finder_status}" -ne 0 && "${finder_status}" -ne 141 ]]; then
        echo "ffd: fd exited ${finder_status}, the file list was incomplete" >&2
        return "${finder_status}"
    fi

    case "${status}" in
        # fzf's own: 1 on no match, 130 when the user aborts. On both the opener
        # never ran, so neither is a failure of this script.
        1 | 130) return 0 ;;
        # The two statuses the opener remapped, put back as the tool's own.
        121) return 1 ;;
        122) return 130 ;;
        *) return "${status}" ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
