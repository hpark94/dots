#!/usr/bin/env bash
# LocalCommand hook after each SSH master connection, so a Headless machine that
# missed a toggle catches up (.scratch/theme-switch-expansion/spec.md).
set -euo pipefail

host=${1:-}
[[ -n "${host}" ]] || exit 0

# Recursion guard: the push below opens its own SSH connection to ${host}, which
# would re-fire this LocalCommand. The child ssh inherits the exported flag and
# short-circuits here, so the push never triggers itself.
[[ -n "${THEME_PUSH_INFLIGHT:-}" ]] && exit 0
export THEME_PUSH_INFLIGHT=1

# Only a Desktop with a decided mode has anything to push.
role_file="${XDG_CONFIG_HOME:-${HOME}/.config}/dotfiles/role"
[[ -r "${role_file}" ]] || exit 0
[[ "$(tr -d '[:space:]' <"${role_file}")" == "desktop" ]] || exit 0

state_file="${XDG_STATE_HOME:-${HOME}/.local/state}/theme/mode"
[[ -r "${state_file}" ]] || exit 0
mode=$(tr -d '[:space:]' <"${state_file}")
[[ "${mode}" == "dark" || "${mode}" == "light" ]] || exit 0

# Backgrounded and timeout-bounded so connection setup returns immediately and a
# stalled host cannot hang the shell. The tilde is expanded by the remote shell.
# shellcheck disable=SC2088
(timeout 10 ssh -o BatchMode=yes "${host}" \
    "~/.local/scripts/theme-switch --render ${mode}" >/dev/null 2>&1 || true) &
exit 0
