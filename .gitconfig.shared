[user]
	name = Hyeong-Gyu Park
	email = hyeonggyu94@googlemail.com
[core]
	excludesFile = ~/.gitignore
	editor = nvim
	pager = delta-auto
[init]
	defaultBranch = main
[pull]
	rebase = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[include]
	path = ~/.local/state/theme/delta.gitconfig
